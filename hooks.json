[
  {
    "id": "trigger-mix",
    "execute-command": "/usr/local/bin/mix.sh",
    "command-working-directory": "/tmp",
    "include-command-output-in-response": true,
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "{{ getenv `WEBHOOK_SECRET_TOKEN` }}",
        "parameter": {
          "source": "url",
          "name": "token"
        }
      }
    }
  }
]
