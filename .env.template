# Clash Configuration Mixer - Environment Variables Template

# System Permissions (Fallback to current host user/group if left empty)
HOST_UID=${UID:-1000}
HOST_GID=${GID:-1000}
TZ=Europe/Moscow

# Host Paths (Absolute or relative to docker-compose.yml)
CLASH_OUT_CFG_DIR=./cfg-out
GIT_SYNC_DIR=./git-repo
CLASH_CACHE_DIR=./cache

# Public base URL of clash-profile-server (host reachable from Clash Meta For Android)
# PROFILE_BASE_URL=http://192.168.1.10:8181
PROFILE_BASE_URL=http://localhost:8181

# Security Tokens & Secrets
WEBHOOK_SECRET_TOKEN=change_me_to_something_secure_please
MIHOMO_SECRET=make_mihomo_great_again
